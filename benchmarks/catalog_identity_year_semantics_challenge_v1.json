        "generation": "2020 global generation",
        "variant": "XRX Hybrid",
        "powertrain": "1.8 hybrid flex",
        "transmission": "Hybrid Transaxle CVT",
        "body_style": "SUV",
        "market": "BR",
        "manufacture_year_from": 2025,
        "manufacture_year_to": 2025,
