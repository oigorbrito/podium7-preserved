  "purpose": "Source-backed regression slice for the owner-selected manufacture-year versus model-year policy. Senatran/RENAVAM fields remain distinct, explicit non-overlap in either dimension is contradictory, and missing model-year evidence does not justify an automatic structural match.",
  "sources": [
    {
      "id": "senatran-renavam-fields",
      "publisher": "Secretaria Nacional de Trânsito / SERPRO",
      "title": "Consulta Online Senatran — Veículo",
      "url": "https://centraldeajuda.serpro.gov.br/consultasenatran/veiculo/",
      "supports": "RENAVAM exposes Ano Fabricação and Ano Modelo as separate vehicle fields."
    },
    {
      "id": "fipe-official-year-semantics",
      "publisher": "Fundação Instituto de Pesquisas Econômicas",
      "title": "Preço Médio de Veículos — Tabela Fipe",
      "url": "https://www.fipe.org.br/pt-br/indices/veiculos",
      "supports": "FIPE explicitly states that the vehicle year used in its lookup refers to model year."
    },
    {
      "id": "toyota-corolla-cross-2024-2025",
      "publisher": "Toyota do Brasil",
      "title": "Preços Públicos — Maio 2024",
      "url": "https://media.toyota.com.br/dbff4f05-d6ed-47e8-bb7d-073369a7cff7.pdf",
      "supports": "Corolla Cross XRX Hybrid is published with 2024 / 2025 year/model notation."
